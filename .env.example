# Copy to .env and fill in real values. Never commit .env.

# REQUIRED — Google Gemini API key (https://aistudio.google.com/apikey)
MFA_GEMINI_API_KEY=your-gemini-key-here

# REQUIRED — LlamaParse API key (https://cloud.llamaindex.ai/api-key)
MFA_LLAMA_PARSE_API_KEY=your-llamaparse-key-here

# Optional — overrides
# MFA_GEMINI_MODEL=models/gemini-3.0-flash
# MFA_GEMINI_TEMPERATURE=0.1
# MFA_LOG_LEVEL=INFO
# MFA_LOG_JSON=true
# MFA_REQUEST_TIMEOUT_S=60
